<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background tracking while a Törn is running: the "always" location
         tier plus a foreground service (exempt from Doze/battery
         suspension) are what let GPS updates keep coming while the screen
         is locked, which a plain web app can never do. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required by ForegroundNotificationConfig.enableWakeLock, which keeps
         the CPU awake so fixes keep arriving while the screen is locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required to actually display the "Törn läuft" foreground-service
         notification on Android 13+ — without it granted at runtime, the
         service still runs (tracking keeps working) but the notification is
         silently never shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app show the system "exempt from battery optimization"
         dialog (LocationService.ensureIgnoreBatteryOptimizations) —
         confirmed via live testing to be necessary: without it, a real
         device delivered zero position fixes for the entire duration the
         screen was locked, despite the foreground service otherwise
         being correctly configured. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="boat_routes_web"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Restricted to this app's package name + debug-keystore SHA-1 and
             to the Maps SDK for Android only (see the plan notes on why this
             is a separate key from the web build's, which is restricted by
             HTTP referrer instead — Android doesn't use referrers). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyC_VK8fdB9ZDTBIbUYP3nbZkwBgXvMceCs" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_background_service's own Android Service: runs Törn
             recording in a genuinely independent isolate/engine, not tied to
             MainActivity, unlike geolocator_android's
             foregroundNotificationConfig (see background_tracking_service.dart
             for why that distinction matters). foregroundServiceType must
             match one of the FOREGROUND_SERVICE_* permissions above. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:exported="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
