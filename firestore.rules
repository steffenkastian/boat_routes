rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own profile, created on first sign-in with isAdmin: false.
    // isAdmin can never be set/changed by a client write (create requires
    // false, update must keep it unchanged) — only by editing the document
    // directly in the Firestore console.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.isAdmin == false;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.isAdmin == resource.data.isAdmin;
    }

    // Reads stay open (PLZ search works without login). Only signed-in
    // admins (per their users/{uid} doc) can publish a new regatta; nothing
    // can be edited or removed afterwards.
    match /regattas/{regattaId} {
      allow read: if true;
      allow create: if request.auth != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
