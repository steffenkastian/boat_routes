rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own profile, created on first sign-in with isAdmin: false.
    // isAdmin can never be set/changed by a client write (create requires
    // false, update must keep it unchanged) — only by editing the document
    // directly in the Firestore console.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.isAdmin == false;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.isAdmin == resource.data.isAdmin;

      // A user's own synced routes/Törns — fully private, never public.
      match /routes/{routeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /tours/{tourId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reads stay open (PLZ search works without login). Only signed-in
    // admins (per their users/{uid} doc) can publish a new regatta; nothing
    // can be edited or removed afterwards.
    match /regattas/{regattaId} {
      allow read: if true;
      allow create: if request.auth != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update, delete: if false;
    }

    // A shared route/Törn: either a public link (sharedWithEmail unset —
    // anyone with the id can read, no login needed) or addressed to one
    // specific signed-in email address (only that account's own token can
    // read it; Firebase's email claim is only reliable for identifying
    // *an* account, not proof the recipient owns that mailbox, since this
    // app doesn't enforce email verification — acceptable for sharing, not
    // suitable for anything more sensitive). Only the owner can create,
    // and only under their own uid; nothing is ever mutated after
    // creation, and only the owner can remove it.
    match /shared_items/{shareId} {
      // ownerEmail is only ever shown to recipients as "shared by X" — this
      // still pins it to the actual signed-in account's own email (rather
      // than leaving it client-chosen) so it can't be spoofed to impersonate
      // someone else.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerEmail == request.auth.token.email
                    && (request.resource.data.sharedWithEmail == null
                        || request.resource.data.sharedWithEmail is string);
      // .lower() on both sides: sharedWithEmail is written already
      // lowercased (see ShareService), but request.auth.token.email isn't
      // guaranteed to be — without normalizing here too, an account with
      // any uppercase in its email would never match its own shares.
      allow read: if resource.data.sharedWithEmail == null
                  || (request.auth != null
                      && request.auth.uid == resource.data.ownerUid)
                  || (request.auth != null
                      && request.auth.token.email.lower() == resource.data.sharedWithEmail);
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
